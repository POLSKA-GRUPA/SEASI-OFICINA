{
  "name": "seasi-despacho",
  "productName": "SEASI Despacho",
  "version": "0.1.0",
  "private": true,
  "description": "Shell de escritorio local-first para el kernel SEASI-CORE (despacho fiscal). Electron + TypeScript estricto + React.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:ipc": "node scripts/audit-ipc.mjs",
    "contracts": "node scripts/gen-contracts.mjs",
    "contracts:check": "node scripts/gen-contracts.mjs --check"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^37.0.0",
    "electron-vite": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
